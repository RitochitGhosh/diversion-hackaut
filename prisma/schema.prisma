generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id          String   @id @default(cuid())
  serviceCode String   @unique
  name        String
  description String?
  logoEmoji   String   @default("🏢")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       ServiceMember[]
  queries       Query[]
  knowledgeDocs KnowledgeDocument[]
  subscription  Subscription?
  messages      Message[]

  @@index([ownerId])
}

model ServiceMember {
  id        String   @id @default(cuid())
  userId    String
  email     String
  name      String?
  avatarUrl String?
  role      Role     @default(USER)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  queries      Query[]            @relation("QuerySubmitter")
  reviews      Review[]
  uploadedDocs KnowledgeDocument[]

  @@unique([userId, serviceId])
  @@index([userId])
  @@index([serviceId])
}

enum Role {
  ADMIN
  REVIEWER
  USER
}

model Query {
  id          String      @id @default(cuid())
  content     String      @db.Text
  submitterId String
  submitter   ServiceMember @relation("QuerySubmitter", fields: [submitterId], references: [id])
  serviceId   String
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status      QueryStatus @default(PENDING_AI)
  aiDraft     String?     @db.Text
  finalAnswer String?     @db.Text
  sources     Json?       // [{type:'web'|'rag', title, url?, excerpt}]
  agentLog    Json?       // {usedSearch, usedRAG, searchQuery?, ragCount}
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  review Review?

  @@index([serviceId, status])
  @@index([submitterId])
}

enum QueryStatus {
  PENDING_AI
  PENDING_REVIEW
  APPROVED
  EDITED
  REJECTED
  ANSWERED
}

model Review {
  id            String       @id @default(cuid())
  action        ReviewAction
  editedContent String?      @db.Text
  note          String?      @db.Text
  reviewerId    String
  reviewer      ServiceMember @relation(fields: [reviewerId], references: [id])
  queryId       String       @unique
  query         Query        @relation(fields: [queryId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([reviewerId])
}

enum ReviewAction {
  APPROVED
  EDITED
  REJECTED
}

model KnowledgeDocument {
  id           String   @id @default(cuid())
  title        String
  fileName     String?
  content      String   @db.Text
  chunkCount   Int      @default(0)
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   ServiceMember @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  chunks KnowledgeChunk[]

  @@index([serviceId])
}

model KnowledgeChunk {
  id            String   @id @default(cuid())
  content       String   @db.Text
  embeddingJson String   @db.Text  // JSON float[] — 768-dim Gemini embedding
  chunkIndex    Int
  documentId    String
  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Subscription {
  id            String    @id @default(cuid())
  serviceId     String    @unique
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tier          String    @default("FREE") // FREE | PRO | ENTERPRISE
  algoTxId      String?   @unique
  walletAddress String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id        String      @id @default(cuid())
  role      MessageRole
  content   String      @db.Text
  userId    String      // Auth0 sub of the user who owns this conversation
  serviceId String
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  queryId   String?     // Links USER + ASSISTANT messages that belong to the same query
  createdAt DateTime    @default(now())

  @@index([userId, serviceId, createdAt(sort: Desc)])
  @@index([queryId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // Auth0 sub of the recipient
  type      String   // QUERY_SUBMITTED | QUERY_ANSWERED | QUERY_REJECTED | QUERY_PENDING_REVIEW
  title     String
  message   String
  read      Boolean  @default(false)
  queryId   String?
  serviceId String?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId])
}
