generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id          String   @id @default(cuid())
  serviceCode String   @unique
  name        String
  description String?
  logoEmoji   String   @default("🏢")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       ServiceMember[]
  queries       Query[]
  knowledgeDocs KnowledgeDocument[]

  @@index([ownerId])
}

model ServiceMember {
  id        String   @id @default(cuid())
  userId    String
  email     String
  name      String?
  avatarUrl String?
  role      Role     @default(USER)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  queries      Query[]            @relation("QuerySubmitter")
  reviews      Review[]
  uploadedDocs KnowledgeDocument[]

  @@unique([userId, serviceId])
  @@index([userId])
  @@index([serviceId])
}

enum Role {
  ADMIN
  REVIEWER
  USER
}

model Query {
  id          String      @id @default(cuid())
  content     String      @db.Text
  submitterId String
  submitter   ServiceMember @relation("QuerySubmitter", fields: [submitterId], references: [id])
  serviceId   String
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status      QueryStatus @default(PENDING_AI)
  aiDraft     String?     @db.Text
  finalAnswer String?     @db.Text
  sources     Json?       // [{type:'web'|'rag', title, url?, excerpt}]
  agentLog    Json?       // {usedSearch, usedRAG, searchQuery?, ragCount}
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  review Review?

  @@index([serviceId, status])
  @@index([submitterId])
}

enum QueryStatus {
  PENDING_AI
  PENDING_REVIEW
  APPROVED
  EDITED
  REJECTED
  ANSWERED
}

model Review {
  id            String       @id @default(cuid())
  action        ReviewAction
  editedContent String?      @db.Text
  note          String?      @db.Text
  reviewerId    String
  reviewer      ServiceMember @relation(fields: [reviewerId], references: [id])
  queryId       String       @unique
  query         Query        @relation(fields: [queryId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([reviewerId])
}

enum ReviewAction {
  APPROVED
  EDITED
  REJECTED
}

model KnowledgeDocument {
  id           String   @id @default(cuid())
  title        String
  fileName     String?
  content      String   @db.Text
  chunkCount   Int      @default(0)
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   ServiceMember @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  chunks KnowledgeChunk[]

  @@index([serviceId])
}

model KnowledgeChunk {
  id            String   @id @default(cuid())
  content       String   @db.Text
  embeddingJson String   @db.Text  // JSON float[] — 768-dim Gemini embedding
  chunkIndex    Int
  documentId    String
  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}
